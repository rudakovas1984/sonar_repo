
Функция ПолучитьЗаписиGET(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/JSON; charset=utf-8");
	
	Параметры = Запрос.ПараметрыЗапроса;
	
	Параметр_Врач = Параметры.Получить("doctor");
	Параметр_Клиент = Параметры.Получить("client");
	Параметр_Дата = Параметры.Получить("date");
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаписьКлиента.Ссылка КАК Ссылка,
	|	ЗаписьКлиента.Врач КАК Врач,
	|	ЗаписьКлиента.ДатаВремяНачалаПриема КАК ДатаВремяНачала,
	|	ЗаписьКлиента.ДатаВремяОкончанияПриема КАК ДатаВремяОкончания,
	|	ЗаписьКлиента.Клиент КАК Клиент
	|ИЗ
	|	Документ.ЗаписьКлиента КАК ЗаписьКлиента
	|ГДЕ
	|	ИСТИНА";
	
	Если ЗначениеЗаполнено(Параметр_Врач) Тогда 
		ТекстЗапроса = ТекстЗапроса + " И ЗаписьКлиента.Врач = &Параметр_Врач";
		Запрос.УстановитьПараметр("Параметр_Врач", Параметр_Врач);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметр_Клиент) Тогда 
		ТекстЗапроса = ТекстЗапроса + " И ЗаписьКлиента.Клиент = &Параметр_Клиент";
		Запрос.УстановитьПараметр("Параметр_Клиент", Параметр_Клиент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметр_Дата) Тогда 
		// Формат даты YYYYMMDD
		Попытка
			ДатаПриема = Дата(Параметр_Дата);
			ТекстЗапроса = ТекстЗапроса + " И ЗаписьКлиента.ДатаВремяНачалаПриема МЕЖДУ &ДатаНачала И &ДатаОкончания";
			Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПриема));
			Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПриема));
		Исключение
			Ответ.УстановитьТелоИзСтроки("Ошибка формата даты date (ожидается YYYYMMDD)", КодировкаТекста.UTF8);
			Ответ.КодСостояния = 400;
			Возврат Ответ;
		КонецПопытки;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Формируем JSON
	Массив = Новый Массив;
	Для Каждого Строка Из Результат Цикл 
		Элемент = Новый Структура;
		Элемент.Вставить("ref", Строка(Строка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("doctor", Строка.Врач);
		Элемент.Вставить("start", Формат(Строка.ДатаВремяНачала, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Элемент.Вставить("end", Формат(Строка.ДатаВремяОкончания, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Элемент.Вставить("client", Строка.Клиент);
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции

Функция СоздатьЗаписиPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Ответ.УстановитьТелоИзСтроки("Некорректный JSON", КодировкаТекста.UTF8);
		Ответ.КодСостояния = 400;
		Возврат Ответ;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда 
		Ответ.УстановитьТелоИзСтроки("Ожидается массив объектов", КодировкаТекста.UTF8);
		Ответ.КодСостояния = 400;
		Возврат Ответ;
	КонецЕсли;
	
	Результаты = Новый Массив;
	
	Для Каждого Элемент Из Данные Цикл 
		
		// Нужно добавить проверку на существующие записи
		
		НовыйДок = Документы.ЗаписьКлиента.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		
		Если ЗначениеЗаполнено(Элемент.doctor) Тогда 
			НовыйДок.Врач = Элемент.doctor;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элемент.client) Тогда 
			НовыйДок.Клиент = Элемент.client;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Элемент.start) Тогда 
			НовыйДок.ДатаВремяНачалаПриема = Дата(Элемент.start);
		КонецЕсли;
		Если ЗначениеЗаполнено(Элемент.end) Тогда 
			НовыйДок.ДатаВремяОкончанияПриема = Дата(Элемент.end);
		КонецЕсли;
		
		Попытка
			НовыйДок.Записать();
			Результаты.Добавить(Новый Структура("ref", Строка(НовыйДок.Ссылка.УникальныйИдентификатор()), "status", "ok"));
		Исключение
			Результаты.Добавить(Новый Структура("status", "error", "message", ОписаниеОшибки()));
		КонецПопытки;
		
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Результаты);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции
